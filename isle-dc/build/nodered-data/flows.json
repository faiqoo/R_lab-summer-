                "b4954fe26121444e"
            ]
        ]
    },
    {
        "id": "668c379933ab59f1",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Prepare XML Upload Request",
        "func": "// Assume msg.payload contains XML from BentoML\nconst contentLocation = flow.get(\"fileUploadUri\")\nmsg.headers = {\n    \"Content-Type\": \"application/xml\",\n    \"Content-Location\": contentLocation,\n    \"Content-type\": \"application/xml\"\n};\nmsg.url = flow.get(\"destinationUrl\");\nmsg.method = \"PUT\";\nmsg.contentLocation = contentLocation;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],

    {
        "id": "9871785a0e135a91",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Prepare Media Request Query",
        "func": "// Extract the URL from the JSON payload\nlet url = msg.payload.attachment.content.source_uri;\n\n// Extract the authorization header from STOMP headers\nlet authHeader = msg.headers['Authorization'] || msg.headers['authorization'] || '';\n\n// Prepare msg for HTTP request\nmsg.url = url;\nmsg.authorization = authHeader\n\n// Optionally, set method or body\nmsg.method = \"GET\"; // or \"POST\" depending on the API\n\nflow.set(\"destinationUrl\", msg.payload.attachment.content.destination_uri);\nflow.set(\"fileUploadUri\", msg.payload.attachment.content.file_upload_uri);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 850,

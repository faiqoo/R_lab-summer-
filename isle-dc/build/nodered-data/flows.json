    {
        "id": "44951acb56720f23",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Prepare BentoML query",
        "func": "// Node-RED Function node snippet\n// Assumes msg.payload contains the PDF as a binary Buffer\n\nmsg.method = \"POST\";\nmsg.url = \"http://bentoml:3000/transcribe_document\";\n\n// Construct the multipart/form-data payload\nmsg.headers = {\n    \"accept\": \"text/plain\"\n};\n\nmsg.payload = {\n    input_data: {\n            value: msg.payload,\n            options: {\n                filename: \"file.pdf\",\n                contentType: \"application/pdf\"\n            }\n        }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1210,
        "y": 380,
        "wires": [

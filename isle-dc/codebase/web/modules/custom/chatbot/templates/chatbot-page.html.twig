<div id="chatbot-container">

  <h2>Islandora Chatbot</h2>

  <div id="chat-window">
    <div class="bot-message">
      Hello! Ask me anything about Islandora.
    </div>
  </div>

  <div class="chat-input">
    <input
      id="user-message"
      type="text"
      placeholder="Ask something..."
    >

    <button id="send-btn">
      Send
    </button>
  </div>

</div>
# Copy this to .env and fill in your values.
# .env is gitignored — never commit it.

# --- Auth ---
# Bearer token from HAWKI web UI: Profile → API Tokens
HAWKI_TOKEN=

# --- LLM (HAWKI) ---
# HAWKI_API_URL=https://chat.edu-ki-rlp.de
# HAWKI_MODEL=meta-llama-3.1-8b-instruct

# --- Vector DB (Qdrant) ---
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_COLLECTION=islandora_chunks

# --- Embedding ---
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- RAG pipeline ---
# RAG_TOP_K=5
# RAG_CHUNK_SIZE=512
# RAG_CHUNK_OVERLAP=64

# --- Evaluation (make install-eval && make eval; see docs/evaluation.md) ---
# RAG_EVAL_MODEL=openai-gpt-oss-120b
# RAG_SYNTHESIS_MODEL=qwen3-30b-a3b-instruct-2507
# RAG_EVAL_MAX_CONCURRENT=4
